{
  "name": "fpl-agent",
  "version": "0.0.15",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "corepack pnpm --filter @fpl-agent/web dev",
    "build": "corepack pnpm --filter @fpl-agent/web build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/web/tsconfig.json",
    "benchmark": "tsx scripts/benchmark.ts",
    "benchmark:rules": "tsx scripts/benchmark-rules.ts",
    "benchmark:refresh": "tsx scripts/benchmark-refresh.ts",
    "benchmark:variants": "tsx scripts/benchmark-variants.ts",
    "benchmark:fixtures": "tsx scripts/benchmark-fixtures.ts",
    "benchmark:probability": "tsx scripts/benchmark-probability.ts",
    "analyze:squad": "tsx scripts/optimize-squad.ts",
    "squad:utility": "tsx scripts/generate-squad-utility.ts",
    "counterfactuals": "tsx scripts/generate-counterfactuals.ts",
    "concentration": "tsx scripts/generate-concentration-analysis.ts",
    "refresh": "tsx scripts/refresh.ts",
    "fetch:data": "tsx scripts/fetch-fpl-data.ts",
    "fetch:players": "tsx scripts/fetch-player-data.ts",
    "fetch:pl-fixtures": "tsx scripts/fetch-premier-league-fixtures.ts",
    "evidence": "tsx scripts/generate-evidence.ts",
    "odds": "tsx scripts/generate-odds.ts",
    "set-pieces": "tsx scripts/generate-set-pieces.ts",
    "team-news": "tsx scripts/generate-team-news.ts",
    "fixtures": "tsx scripts/generate-fixture-ticker.ts",
    "minutes": "tsx scripts/generate-minutes-risk.ts",
    "roles": "tsx scripts/generate-current-role.ts",
    "public-evidence": "tsx scripts/generate-public-evidence.ts",
    "recommend": "tsx scripts/generate-recommendation.ts",
    "compare:squads": "tsx scripts/compare-squads.ts",
    "variant:list": "tsx scripts/variant-list.ts",
    "variant:verify": "tsx scripts/variant-verify.ts",
    "variant:compare": "tsx scripts/variant-compare.ts",
    "verify": "tsx scripts/verify-recommendation.ts",
    "postmortem": "node scripts/not-implemented.mjs postmortem"
  },
  "devDependencies": {
    "@types/node": "26.1.0",
    "playwright": "^1.62.0",
    "tsx": "4.22.5",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  }
}
